//@version=6
strategy("Tree of Life + Astrology 7:1", overlay=true, initial_capital=10000, pyramiding=0,
     margin_long=0, margin_short=0, slippage=0,
     commission_type=strategy.commission.cash_per_contract,
     commission_value=0.15,          // per side, USD per oz (0.30 round trip). Edit to your broker's real cost.
     max_lines_count=100, max_labels_count=100)

// =====================================================================
//  IDEA
//  1. Find confirmed swing points with an ATR zigzag (no repainting).
//  2. Take the last 10 swings and treat them as the 10 Sephirot visited
//     in Lightning Flash order: Keter -> Chokmah -> Binah -> Chesed ->
//     Gevurah -> Tiferet -> Netzach -> Hod -> Yesod -> Malkuth.
//  3. Template = height of each node on the Tree (7 rows) plus a small
//     left/right offset for the pillars of Severity / Mercy.
//  4. Pearson correlation between the 10 swing prices and the template.
//  5. |corr| >= threshold -> trade, stop at the last opposite swing, 7R target.
//  6. Optional filters: trading session, Mercury retrograde, Moon phase bias.
// =====================================================================

// ---------------- inputs
gS = "Swings"
atrLen   = input.int(14, "ATR length", minval=1, group=gS)
devMult  = input.float(2.0, "Swing size = ATR x", minval=0.5, step=0.25, group=gS)

gT = "Tree template"
tplMode  = input.string("Tree of Life", "Template", options=["Tree of Life", "Shuffled nodes", "Random values"], group=gT,
     tooltip="Use Shuffled / Random with different seeds as a control. If the real Tree does not clearly beat them, the Tree adds nothing.")
seed     = input.int(1, "Seed (shuffled / random)", minval=1, maxval=2000000000, group=gT)
pillarW  = input.float(0.6, "Pillar offset weight", minval=0.0, maxval=3.0, step=0.1, group=gT)
corrThr  = input.float(0.80, "Min |correlation|", minval=0.3, maxval=0.99, step=0.01, group=gT)
logic    = input.string("Follow the flash", "Signal logic", options=["Follow the flash", "Serpent return (reverse)"], group=gT,
     tooltip="Follow: descending Tree = SELL, ascending = BUY. Serpent return: the opposite.")

numerology = input.bool(false, "Numerology mode: 7 instead of 6", group=gT,
     tooltip="Removes every 6 from the template and uses 7: Keter height 6 -> 7, pillar offset 0.6 -> 0.7, min correlation -> 0.77. Overrides those three inputs.")

gR = "Risk"
rr        = input.float(7.0, "Reward : Risk", minval=1.0, step=0.5, group=gR)
riskPct   = input.float(1.0, "Risk per trade, % of equity", minval=0.1, step=0.1, group=gR)
stopBuf   = input.float(0.2, "Stop buffer beyond swing (ATR x)", minval=0.0, step=0.1, group=gR)
minStop   = input.float(1.0, "Min stop distance (ATR x)", minval=0.1, step=0.1, group=gR)
maxStop   = input.float(6.0, "Max stop distance (ATR x), skip if wider", minval=1.0, step=0.5, group=gR)
maxBars   = input.int(0, "Time stop in bars (0 = off)", minval=0, group=gR)
showDraw  = input.bool(true, "Draw the 10 swings", group=gR)

gF = "Session and astrology filters"
sessMode  = input.string("London + New York", "Session filter", group=gF,
     options=["Off", "London + New York", "London", "New York"],
     tooltip="London + New York = 03:00-12:00 New York time. London = 08:00-16:30 London. New York = 08:00-17:00 New York. Only works on intraday charts. Applies to new entries only.")
astroMode = input.string("Both", "Astrology filter", group=gF,
     options=["Off", "Skip Mercury retrograde", "Moon bias", "Both"],
     tooltip="Skip Mercury retrograde: no new trades while Mercury is retrograde. Moon bias: waxing Moon = BUY only, waning Moon = SELL only. Set to Off to compare against the pure Tree strategy.")
shadeRx   = input.bool(true, "Shade Mercury retrograde on chart", group=gF)

// effective values (numerology overrides)
pillarEff = numerology ? 0.7 : pillarW
corrEff   = numerology ? 0.77 : corrThr
keterH    = numerology ? 7.0 : 6.0

// ---------------- template (built once)
nodeNames = array.from("Keter", "Chokmah", "Binah", "Chesed", "Gevurah", "Tiferet", "Netzach", "Hod", "Yesod", "Malkuth")
rows      = array.from(keterH, 5.0, 5.0, 4.0, 4.0, 3.0, 2.0, 2.0, 1.0, 0.0)     // height on the Tree
pillars   = array.from(0.0, 1.0, -1.0, 1.0, -1.0, 0.0, 1.0, -1.0, 0.0, 0.0)  // +1 Mercy, -1 Severity, 0 middle
var array<float> tpl = array.new<float>(10, 0.0)

if barstate.isfirst
    for i = 0 to 9
        tpl.set(i, rows.get(i) + pillarEff * pillars.get(i))
    float s = seed
    if tplMode == "Shuffled nodes"
        for i = 9 to 1
            s := (s * 16807) % 2147483647
            int j = int(s % (i + 1))
            float tmp = tpl.get(i)
            tpl.set(i, tpl.get(j))
            tpl.set(j, tmp)
    else if tplMode == "Random values"
        for i = 0 to 9
            s := (s * 16807) % 2147483647
            tpl.set(i, 6.0 * (s / 2147483647.0))

// ---------------- session filter
inLN  = not na(time(timeframe.period, "0300-1200", "America/New_York"))
inLon = not na(time(timeframe.period, "0800-1630", "Europe/London"))
inNY  = not na(time(timeframe.period, "0800-1700", "America/New_York"))
bool sessOK = true
if timeframe.isintraday
    sessOK := switch sessMode
        "London + New York" => inLN
        "London" => inLon
        "New York" => inNY
        => true

// ---------------- astronomy (low-precision Keplerian elements, Schlyter's formulas)
atan2r(float y, float x) =>
    float r = 0.0
    if x > 0
        r := math.atan(y / x)
    else if x < 0
        r := y >= 0 ? math.atan(y / x) + math.pi : math.atan(y / x) - math.pi
    else
        r := y > 0 ? math.pi / 2 : y < 0 ? -math.pi / 2 : 0.0
    r

kepler(float mDeg, float e) =>
    float m = math.toradians(mDeg)
    float ea = m + e * math.sin(m) * (1.0 + e * math.cos(m))
    for k = 1 to 5
        ea := ea - (ea - e * math.sin(ea) - m) / (1.0 - e * math.cos(ea))
    ea

// geocentric ecliptic longitude of Mercury in degrees; d = days since 2000 Jan 0.0
mercLon(float d) =>
    float wS = 282.9404 + 4.70935e-5 * d
    float eS = 0.016709 - 1.151e-9 * d
    float mS = 356.0470 + 0.9856002585 * d
    float eaS = kepler(mS, eS)
    float xvS = math.cos(eaS) - eS
    float yvS = math.sqrt(1.0 - eS * eS) * math.sin(eaS)
    float rS = math.sqrt(xvS * xvS + yvS * yvS)
    float lonS = atan2r(yvS, xvS) + math.toradians(wS)
    float xs = rS * math.cos(lonS)
    float ys = rS * math.sin(lonS)

    float nn = math.toradians(48.3313 + 3.24587e-5 * d)
    float inc = math.toradians(7.0047 + 5.0e-8 * d)
    float w = math.toradians(29.1241 + 1.01444e-5 * d)
    float a = 0.387098
    float e = 0.205635 + 5.59e-10 * d
    float mm = 168.6562 + 4.0923344368 * d
    float ea = kepler(mm, e)
    float xv = a * (math.cos(ea) - e)
    float yv = a * math.sqrt(1.0 - e * e) * math.sin(ea)
    float vw = atan2r(yv, xv) + w
    float r = math.sqrt(xv * xv + yv * yv)
    float xh = r * (math.cos(nn) * math.cos(vw) - math.sin(nn) * math.sin(vw) * math.cos(inc))
    float yh = r * (math.sin(nn) * math.cos(vw) + math.cos(nn) * math.sin(vw) * math.cos(inc))
    math.todegrees(atan2r(yh + ys, xh + xs))

float dDays = time / 86400000.0 + 2440587.5 - 2451543.5
float lonNow = mercLon(dDays)
float lonPrev = mercLon(dDays - 1.0)
float dLon = (lonNow - lonPrev + 540.0) % 360.0 - 180.0
bool mercRx = dLon < 0                         // retrograde = longitude decreasing

// moon age in days since a reference new moon (2000-01-06 18:14 UTC)
float moonAge = ((time / 1000.0 - 947182440.0) / 86400.0) % 29.530588853
bool waxing = moonAge < 14.765294

bool useMerc = astroMode == "Skip Mercury retrograde" or astroMode == "Both"
bool useMoon = astroMode == "Moon bias" or astroMode == "Both"

bgcolor(shadeRx and mercRx ? color.new(color.orange, 93) : na)

// ---------------- swing storage
var array<float> pP = array.new<float>()   // prices
var array<int>   pTm = array.new<int>()    // bar times
var array<int>   pT = array.new<int>()     // +1 high, -1 low

addPivot(array<float> pr, array<int> tm, array<int> ty, float p, int t, int k) =>
    pr.push(p)
    tm.push(t)
    ty.push(k)
    if pr.size() > 10
        pr.shift()
        tm.shift()
        ty.shift()
    true

atr = ta.atr(atrLen)

var int   zDir = 0
var float extP = na
var int   extT = na
var float lastC = na
var array<line>  lns = array.new<line>()
var array<label> lbs = array.new<label>()

bool newPivot = false

if barstate.isconfirmed and not na(atr)
    float thr = devMult * atr
    if zDir == 0
        zDir := 1
        extP := high
        extT := time
    else if zDir == 1
        if high > extP
            extP := high
            extT := time
        else if low < extP - thr
            addPivot(pP, pTm, pT, extP, extT, 1)
            newPivot := true
            zDir := -1
            extP := low
            extT := time
    else
        if low < extP
            extP := low
            extT := time
        else if high > extP + thr
            addPivot(pP, pTm, pT, extP, extT, -1)
            newPivot := true
            zDir := 1
            extP := high
            extT := time

// ---------------- evaluate on every new confirmed swing
if newPivot and pP.size() == 10
    float sd = pP.stdev() * tpl.stdev()
    lastC := sd > 0 ? pP.covariance(tpl) / sd : 0.0

    if showDraw
        for l in lns
            line.delete(l)
        for b in lbs
            label.delete(b)
        lns.clear()
        lbs.clear()
        for i = 0 to 9
            label lb = label.new(pTm.get(i), pP.get(i),
                 text = tplMode == "Tree of Life" ? nodeNames.get(i) : str.tostring(i + 1),
                 xloc = xloc.bar_time,
                 style = pT.get(i) == 1 ? label.style_label_down : label.style_label_up,
                 size = size.small, color = color.new(color.purple, 20), textcolor = color.white)
            lbs.push(lb)
            if i > 0
                lns.push(line.new(pTm.get(i - 1), pP.get(i - 1), pTm.get(i), pP.get(i),
                     xloc = xloc.bar_time, color = color.new(color.purple, 30)))

    int sig = 0
    if math.abs(lastC) >= corrEff
        sig := lastC > 0 ? -1 : 1          // descending Tree -> SELL, ascending -> BUY
        if logic == "Serpent return (reverse)"
            sig := -sig

    bool moonOK = not useMoon or (sig == 1 ? waxing : not waxing)
    bool mercOK = not useMerc or not mercRx
    bool allowed = sessOK and moonOK and mercOK

    if sig != 0 and allowed and strategy.position_size == 0
        int need = sig == -1 ? 1 : -1      // SELL: stop above last swing high; BUY: below last swing low
        float ref = na
        for i = pP.size() - 1 to 0
            if pT.get(i) == need
                ref := pP.get(i)
                break
        float dist = sig == -1 ? ref - close : close - ref
        float riskDist = math.max(dist + stopBuf * atr, minStop * atr)
        if riskDist <= maxStop * atr
            float qty = (strategy.equity * riskPct / 100.0) / (riskDist * syminfo.pointvalue)
            string sid = sig == 1 ? "L" : "S"
            strategy.entry(sid, sig == 1 ? strategy.long : strategy.short, qty = qty)
            // ticks are measured from the actual fill price, so gaps are handled correctly
            strategy.exit("X", sid, loss = riskDist / syminfo.mintick, profit = riskDist * rr / syminfo.mintick)

// ---------------- optional time stop
if maxBars > 0 and strategy.position_size != 0
    if bar_index - strategy.opentrades.entry_bar_index(0) >= maxBars
        strategy.close_all(comment = "time stop")

// ---------------- info table
var table tb = table.new(position.top_right, 2, 7, bgcolor = color.new(color.black, 15), frame_color = color.gray, frame_width = 1)
if barstate.islast
    table.cell(tb, 0, 0, "Template", text_color = color.white, text_halign = text.align_left)
    table.cell(tb, 1, 0, tplMode + (numerology ? " (7)" : ""), text_color = color.white)
    table.cell(tb, 0, 1, "Swings", text_color = color.white, text_halign = text.align_left)
    table.cell(tb, 1, 1, str.tostring(pP.size()) + " / 10", text_color = color.white)
    table.cell(tb, 0, 2, "Last corr", text_color = color.white, text_halign = text.align_left)
    table.cell(tb, 1, 2, na(lastC) ? "-" : str.tostring(lastC, "#.00"), text_color = math.abs(nz(lastC)) >= corrEff ? color.lime : color.white)
    table.cell(tb, 0, 3, "Trades", text_color = color.white, text_halign = text.align_left)
    table.cell(tb, 1, 3, str.tostring(strategy.closedtrades), text_color = color.white)
    table.cell(tb, 0, 4, "Session", text_color = color.white, text_halign = text.align_left)
    table.cell(tb, 1, 4, sessOK ? "open" : "closed", text_color = sessOK ? color.lime : color.gray)
    table.cell(tb, 0, 5, "Mercury", text_color = color.white, text_halign = text.align_left)
    table.cell(tb, 1, 5, mercRx ? "retrograde" : "direct", text_color = mercRx ? color.orange : color.white)
    table.cell(tb, 0, 6, "Moon", text_color = color.white, text_halign = text.align_left)
    table.cell(tb, 1, 6, (waxing ? "waxing " : "waning ") + str.tostring(moonAge, "#.0") + "d", text_color = color.white)
